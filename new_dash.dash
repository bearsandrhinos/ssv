  "datasources": {
    "ds-chart-f0d00c98b101": {
      "type": "sql",
      "columns": [
        {
          "name": "SUM(SALE_PRICE)",
          "type": "FLOAT"
        }
      ],
      "sql": "select sum(sale_price) FROM ANALYTICS_PROD.ECOMM.ORDER_ITEMS",
      "filter_bindings": []
    },
    "ds-rental-kpis": {
      "type": "sql",
      "columns": [
        {
          "name": "ASSETS",
          "type": "NUMBER"
        },
        {
          "name": "UTILIZATION",
          "type": "NUMBER"
        },
        {
          "name": "PLACEMENTS",
          "type": "NUMBER"
        },
        {
          "name": "AVG_DAYS_ON_RENT",
          "type": "NUMBER"
        }
      ],
      "sql": "SELECT\n    AGG(uss_assets.asset_count) AS ASSETS,\n    COUNT_IF(uss_assets.status = 'on_rent') / AGG(uss_assets.asset_count) AS UTILIZATION,\n    AGG(uss_placements.placement_count) AS PLACEMENTS,\n    AGG(uss_placements.avg_days_on_rent) AS AVG_DAYS_ON_RENT\nFROM ANALYTICS_PROD.COCO_DEMO.SITE_SERVICES"
    },
    "ds-placements-trend": {
      "type": "sql",
      "columns": [
        {
          "name": "MONTH",
          "type": "DATE"
        },
        {
          "name": "PLACEMENTS",
          "type": "NUMBER"
        },
        {
          "name": "AVG_DAYS_ON_RENT",
          "type": "NUMBER"
        }
      ],
      "sql": "SELECT\n    DATE_TRUNC('month', uss_placements.delivery_date) AS MONTH,\n    AGG(uss_placements.placement_count) AS PLACEMENTS,\n    AGG(uss_placements.avg_days_on_rent) AS AVG_DAYS_ON_RENT\nFROM ANALYTICS_PROD.COCO_DEMO.SITE_SERVICES\nWHERE\n    uss_placements.delivery_date IS NOT NULL\nGROUP BY\n    DATE_TRUNC('month', uss_placements.delivery_date)\nORDER BY\n    MONTH"
    },
    "ds-product-performance": {
      "type": "sql",
      "columns": [
        {
          "name": "PRODUCT_TYPE",
          "type": "VARCHAR"
        },
        {
          "name": "PLACEMENTS",
          "type": "NUMBER"
        },
        {
          "name": "RENTAL_DAYS",
          "type": "NUMBER"
        },
        {
          "name": "AVG_DAYS_ON_RENT",
          "type": "NUMBER"
        }
      ],
      "sql": "SELECT\n    uss_assets.product_type AS PRODUCT_TYPE,\n    AGG(uss_placements.placement_count) AS PLACEMENTS,\n    AGG(uss_placements.total_days_on_rent) AS RENTAL_DAYS,\n    AGG(uss_placements.avg_days_on_rent) AS AVG_DAYS_ON_RENT\nFROM ANALYTICS_PROD.COCO_DEMO.SITE_SERVICES\nGROUP BY\n    uss_assets.product_type\nORDER BY\n    RENTAL_DAYS DESC"
    },
    "ds-fleet-status": {
      "type": "sql",
      "columns": [
        {
          "name": "PRODUCT_TYPE",
          "type": "VARCHAR"
        },
        {
          "name": "STATUS",
          "type": "VARCHAR"
        },
        {
          "name": "ASSETS",
          "type": "NUMBER"
        }
      ],
      "sql": "SELECT\n    uss_assets.product_type AS PRODUCT_TYPE,\n    uss_assets.status AS STATUS,\n    AGG(uss_assets.asset_count) AS ASSETS\nFROM ANALYTICS_PROD.COCO_DEMO.SITE_SERVICES\nGROUP BY\n    uss_assets.product_type,\n    uss_assets.status"
    },
    "ds-site-kpis": {
      "type": "sql",
      "columns": [
        {
          "name": "SITES",
          "type": "NUMBER"
        },
        {
          "name": "SERVICE_ORDERS",
          "type": "NUMBER"
        },
        {
          "name": "ON_TIME_RATE",
          "type": "NUMBER"
        },
        {
          "name": "LATE_MISSED_RATE",
          "type": "NUMBER"
        }
      ],
      "sql": "SELECT\n    AGG(uss_sites.site_count) AS SITES,\n    AGG(uss_service_orders.service_order_count) AS SERVICE_ORDERS,\n    COUNT_IF(uss_service_orders.status = 'completed') / AGG(uss_service_orders.service_order_count) AS ON_TIME_RATE,\n    COUNT_IF(uss_service_orders.status IN ('late', 'missed')) / AGG(uss_service_orders.service_order_count) AS LATE_MISSED_RATE\nFROM ANALYTICS_PROD.COCO_DEMO.SITE_SERVICES"
    },
    "ds-top-sites": {
      "type": "sql",
      "columns": [
        {
          "name": "SITE_ID",
          "type": "VARCHAR"
        },
        {
          "name": "CITY",
          "type": "VARCHAR"
        },
        {
          "name": "STATE",
          "type": "VARCHAR"
        },
        {
          "name": "INDUSTRY_SEGMENT",
          "type": "VARCHAR"
        },
        {
          "name": "PLACEMENTS",
          "type": "NUMBER"
        },
        {
          "name": "RENTAL_DAYS",
          "type": "NUMBER"
        },
        {
          "name": "SERVICE_ORDERS",
          "type": "NUMBER"
        },
        {
          "name": "LATE_MISSED_RATE",
          "type": "NUMBER"
        }
      ],
      "sql": "SELECT\n    uss_sites.site_id AS SITE_ID,\n    uss_sites.city AS CITY,\n    uss_sites.state AS STATE,\n    uss_sites.industry_segment AS INDUSTRY_SEGMENT,\n    AGG(uss_placements.placement_count) AS PLACEMENTS,\n    AGG(uss_placements.total_days_on_rent) AS RENTAL_DAYS,\n    AGG(uss_service_orders.service_order_count) AS SERVICE_ORDERS,\n    COUNT_IF(uss_service_orders.status IN ('late', 'missed')) / NULLIF(AGG(uss_service_orders.service_order_count), 0) AS LATE_MISSED_RATE\nFROM ANALYTICS_PROD.COCO_DEMO.SITE_SERVICES\nGROUP BY\n    uss_sites.site_id,\n    uss_sites.city,\n    uss_sites.state,\n    uss_sites.industry_segment\nORDER BY\n    RENTAL_DAYS DESC NULLS LAST\nLIMIT 25"
    },
    "ds-segment": {
      "type": "sql",
      "columns": [
        {
          "name": "INDUSTRY_SEGMENT",
          "type": "VARCHAR"
        },
        {
          "name": "SITES",
          "type": "NUMBER"
        },
        {
          "name": "RENTAL_DAYS",
          "type": "NUMBER"
        }
      ],
      "sql": "SELECT\n    uss_sites.industry_segment AS INDUSTRY_SEGMENT,\n    AGG(uss_sites.site_count) AS SITES,\n    AGG(uss_placements.total_days_on_rent) AS RENTAL_DAYS\nFROM ANALYTICS_PROD.COCO_DEMO.SITE_SERVICES\nGROUP BY\n    uss_sites.industry_segment\nORDER BY\n    RENTAL_DAYS DESC"
    },
    "ds-state-service": {
      "type": "sql",
      "columns": [
        {
          "name": "STATE",
          "type": "VARCHAR"
        },
        {
          "name": "SERVICE_ORDERS",
          "type": "NUMBER"
        },
        {
          "name": "LATE_MISSED_RATE",
          "type": "NUMBER"
        }
      ],
      "sql": "SELECT\n    uss_sites.state AS STATE,\n    AGG(uss_service_orders.service_order_count) AS SERVICE_ORDERS,\n    COUNT_IF(uss_service_orders.status IN ('late', 'missed')) / AGG(uss_service_orders.service_order_count) AS LATE_MISSED_RATE\nFROM ANALYTICS_PROD.COCO_DEMO.SITE_SERVICES\nGROUP BY\n    uss_sites.state\nORDER BY\n    LATE_MISSED_RATE DESC"
    },
    "ds-route-kpis": {
      "type": "sql",
      "columns": [
        {
          "name": "ROUTES",
          "type": "NUMBER"
        },
        {
          "name": "AVG_STOPS_PER_ROUTE",
          "type": "NUMBER"
        },
        {
          "name": "LIGHT_ROUTE_SHARE",
          "type": "NUMBER"
        },
        {
          "name": "CONSOLIDATION_DAYS",
          "type": "NUMBER"
        }
      ],
      "sql": "WITH routes AS (\n    SELECT\n        uss_routes.route_id AS ROUTE_ID,\n        uss_routes.branch_id AS BRANCH_ID,\n        uss_routes.route_date AS ROUTE_DATE,\n        AGG(uss_routes.total_planned_stops) AS STOPS\n    FROM ANALYTICS_PROD.COCO_DEMO.SITE_SERVICES\n    GROUP BY\n        uss_routes.route_id,\n        uss_routes.branch_id,\n        uss_routes.route_date\n),\nbranch_days AS (\n    SELECT\n        BRANCH_ID,\n        ROUTE_DATE,\n        COUNT_IF(STOPS <= 7) AS LIGHT_ROUTES\n    FROM routes\n    GROUP BY\n        BRANCH_ID,\n        ROUTE_DATE\n)\nSELECT\n    (SELECT COUNT(*) FROM routes) AS ROUTES,\n    (SELECT AVG(STOPS) FROM routes) AS AVG_STOPS_PER_ROUTE,\n    (SELECT COUNT_IF(STOPS <= 7) / COUNT(*) FROM routes) AS LIGHT_ROUTE_SHARE,\n    (SELECT COUNT_IF(LIGHT_ROUTES >= 2) FROM branch_days) AS CONSOLIDATION_DAYS"
    },
    "ds-branch-routes": {
      "type": "sql",
      "columns": [
        {
          "name": "BRANCH_ID",
          "type": "VARCHAR"
        },
        {
          "name": "LIGHT_ROUTES",
          "type": "NUMBER"
        },
        {
          "name": "CONSOLIDATION_DAYS",
          "type": "NUMBER"
        },
        {
          "name": "AVG_STOPS_PER_ROUTE",
          "type": "NUMBER"
        }
      ],
      "sql": "WITH routes AS (\n    SELECT\n        uss_routes.route_id AS ROUTE_ID,\n        uss_routes.branch_id AS BRANCH_ID,\n        uss_routes.route_date AS ROUTE_DATE,\n        AGG(uss_routes.total_planned_stops) AS STOPS\n    FROM ANALYTICS_PROD.COCO_DEMO.SITE_SERVICES\n    GROUP BY\n        uss_routes.route_id,\n        uss_routes.branch_id,\n        uss_routes.route_date\n),\nbranch_days AS (\n    SELECT\n        BRANCH_ID,\n        ROUTE_DATE,\n        COUNT(*) AS ROUTES,\n        SUM(STOPS) AS STOPS,\n        COUNT_IF(STOPS <= 7) AS LIGHT_ROUTES\n    FROM routes\n    GROUP BY\n        BRANCH_ID,\n        ROUTE_DATE\n)\nSELECT\n    BRANCH_ID,\n    SUM(LIGHT_ROUTES) AS LIGHT_ROUTES,\n    COUNT_IF(LIGHT_ROUTES >= 2) AS CONSOLIDATION_DAYS,\n    SUM(STOPS) / SUM(ROUTES) AS AVG_STOPS_PER_ROUTE\nFROM branch_days\nGROUP BY\n    BRANCH_ID\nORDER BY\n    LIGHT_ROUTES DESC"
    },
    "ds-branch-late": {
      "type": "sql",
      "columns": [
        {
          "name": "BRANCH_ID",
          "type": "VARCHAR"
        },
        {
          "name": "LATE_MISSED_RATE",
          "type": "NUMBER"
        }
      ],
      "sql": "SELECT\n    uss_routes.branch_id AS BRANCH_ID,\n    COUNT_IF(uss_service_orders.status IN ('late', 'missed')) / AGG(uss_service_orders.service_order_count) AS LATE_MISSED_RATE\nFROM ANALYTICS_PROD.COCO_DEMO.SITE_SERVICES\nGROUP BY\n    uss_routes.branch_id\nORDER BY\n    LATE_MISSED_RATE DESC"
    },
    "ds-driver-performance": {
      "type": "sql",
      "columns": [
        {
          "name": "DRIVER_ID",
          "type": "VARCHAR"
        },
        {
          "name": "BRANCH_ID",
          "type": "VARCHAR"
        },
        {
          "name": "ROUTES",
          "type": "NUMBER"
        },
        {
          "name": "STOPS_PER_ROUTE",
          "type": "NUMBER"
        },
        {
          "name": "SERVICE_ORDERS",
          "type": "NUMBER"
        },
        {
          "name": "LATE_OR_MISSED",
          "type": "NUMBER"
        },
        {
          "name": "LATE_MISSED_RATE",
          "type": "NUMBER"
        }
      ],
      "sql": "SELECT\n    uss_routes.driver_id AS DRIVER_ID,\n    uss_routes.branch_id AS BRANCH_ID,\n    AGG(uss_routes.route_count) AS ROUTES,\n    AGG(uss_routes.total_planned_stops) / AGG(uss_routes.route_count) AS STOPS_PER_ROUTE,\n    AGG(uss_service_orders.service_order_count) AS SERVICE_ORDERS,\n    COUNT_IF(uss_service_orders.status IN ('late', 'missed')) AS LATE_OR_MISSED,\n    COUNT_IF(uss_service_orders.status IN ('late', 'missed')) / AGG(uss_service_orders.service_order_count) AS LATE_MISSED_RATE\nFROM ANALYTICS_PROD.COCO_DEMO.SITE_SERVICES\nGROUP BY\n    uss_routes.driver_id,\n    uss_routes.branch_id\nORDER BY\n    LATE_MISSED_RATE DESC"
    },
    "ds-service-type-status": {
      "type": "sql",
      "columns": [
        {
          "name": "SERVICE_TYPE",
          "type": "VARCHAR"
        },
        {
          "name": "STATUS",
          "type": "VARCHAR"
        },
        {
          "name": "SERVICE_ORDERS",
          "type": "NUMBER"
        }
      ],
      "sql": "SELECT\n    uss_service_orders.service_type AS SERVICE_TYPE,\n    uss_service_orders.status AS STATUS,\n    AGG(uss_service_orders.service_order_count) AS SERVICE_ORDERS\nFROM ANALYTICS_PROD.COCO_DEMO.SITE_SERVICES\nWHERE\n    uss_service_orders.status IN ('late', 'missed')\nGROUP BY\n    uss_service_orders.service_type,\n    uss_service_orders.status"
    },
    "ds-placements-tree": {
      "type": "sql",
      "columns": [
        {
          "name": "PLACEMENTS",
          "type": "NUMBER"
        },
        {
          "name": "RENTAL_DAYS",
          "type": "NUMBER"
        },
        {
          "name": "AVG_DAYS_ON_RENT",
          "type": "NUMBER"
        }
      ],
      "hierarchy_bindings": [
        {
          "hierarchy_id": "delivery_time"
        }
      ],
      "sql": "SELECT\n    {{ hierarchy_key('delivery_time') }},\n    AGG(uss_placements.placement_count) AS PLACEMENTS,\n    AGG(uss_placements.total_days_on_rent) AS RENTAL_DAYS,\n    AGG(uss_placements.avg_days_on_rent) AS AVG_DAYS_ON_RENT\nFROM ANALYTICS_PROD.COCO_DEMO.SITE_SERVICES\nWHERE\n    uss_placements.delivery_date IS NOT NULL\n    AND {{ hierarchy_rows('delivery_time') }}\nGROUP BY\n    {{ hierarchy_key('delivery_time') }}\nORDER BY\n    1"
    }
  },
  "siArtifactId": "1a7d9b86-b397-44b5-9d65-7190f0c55aed",
  "siArtifactIdempotencyKey": "2d467545-3cb4-404f-b2c6-499098945c07",
  "hierarchies": {
    "delivery_time": {
      "label": "Delivery date",
      "all_member": {
        "label": "All time"
      },
      "levels": [
        {
          "id": "quarter",
          "label": "Quarter",
          "key": {
            "expr": "DATE_TRUNC('QUARTER', uss_placements.delivery_date)::DATE",
            "type": "DATE"
          },
          "display": "TO_CHAR(uss_placements.delivery_date, 'YYYY') || '-Q' || QUARTER(uss_placements.delivery_date)",
          "group_by": [
            "DATE_TRUNC('QUARTER', uss_placements.delivery_date)::DATE",
            "TO_CHAR(uss_placements.delivery_date, 'YYYY') || '-Q' || QUARTER(uss_placements.delivery_date)"
          ]
        },
        {
          "id": "month",
          "label": "Month",
          "key": {
            "expr": "DATE_TRUNC('MONTH', uss_placements.delivery_date)::DATE",
            "type": "DATE"
          },
          "display": "TO_CHAR(uss_placements.delivery_date, 'YYYY-MM')",
          "group_by": [
            "DATE_TRUNC('MONTH', uss_placements.delivery_date)::DATE",
            "TO_CHAR(uss_placements.delivery_date, 'YYYY-MM')"
          ]
        },
        {
          "id": "week",
          "label": "Week",
          "key": {
            "expr": "GREATEST(DATE_TRUNC('WEEK', uss_placements.delivery_date), DATE_TRUNC('MONTH', uss_placements.delivery_date))::DATE",
            "type": "DATE"
          },
          "display": "'Week of ' || TO_CHAR(GREATEST(DATE_TRUNC('WEEK', uss_placements.delivery_date), DATE_TRUNC('MONTH', uss_placements.delivery_date))::DATE, 'YYYY-MM-DD')",
          "group_by": [
            "GREATEST(DATE_TRUNC('WEEK', uss_placements.delivery_date), DATE_TRUNC('MONTH', uss_placements.delivery_date))::DATE",
            "'Week of ' || TO_CHAR(GREATEST(DATE_TRUNC('WEEK', uss_placements.delivery_date), DATE_TRUNC('MONTH', uss_placements.delivery_date))::DATE, 'YYYY-MM-DD')"
          ]
        }
      ]
    }
  }
}