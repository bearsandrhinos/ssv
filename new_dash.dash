              },
              {
                "field": "STOPS_PER_ROUTE",
                "format": {
                  "number": {
                    "precision": 1
                  }
                }
              },
              {
                "field": "SERVICE_ORDERS"
              },
              {
                "field": "LATE_OR_MISSED"
              },
              {
                "field": "LATE_MISSED_RATE",
                "format": {
                  "number": {
                    "precision": 1,
                    "style": "percent"
                  }
                }
              }
            ],
            "sort": [
              {
                "field": "LATE_MISSED_RATE",
                "direction": "desc"
              }
            ]
          }
        }
      ]
    }
  ],
