      ],
      "sql": "WITH base AS (\n    SELECT\n        s.STREAM_ID,\n        s.USER_ID,\n        s.STARTED_AT::DATE AS STREAM_DATE,\n        s.LISTENED_MIN,\n        s.COMPLETION_PCT,\n        s.DOWNLOADED,\n        s.LISTENING_CONTEXT,\n        p.TITLE,\n        p.GENRE,\n        p.RATING,\n        p.SUBSCRIBER_COUNT,\n        u.AGE,\n        u.GENDER,\n        u.COUNTRY,\n        u.STATE,\n        u.TRAFFIC_SOURCE\n    FROM ANALYTICS_PROD.COCO_DEMO.STREAMS s\n    LEFT JOIN ANALYTICS_PROD.COCO_DEMO.PODCASTS p\n        ON s.PODCAST_ID = p.PODCAST_ID\n    LEFT JOIN ANALYTICS_PROD.COCO_DEMO.USERS u\n        ON s.USER_ID = u.ID\n)\nSELECT\n    CASE WHEN AGE < 25 THEN '1. Under 25' WHEN AGE < 35 THEN '2. 25-34' WHEN AGE < 50 THEN '3. 35-49' ELSE '4. 50+' END AS AGE_BAND,\n    COUNT(DISTINCT USER_ID) AS LISTENERS,\n    COUNT(STREAM_ID) AS STREAMS\nFROM base\nWHERE\n    {{ filter('STREAM_DATE') }}\n    AND {{ filter('GENRE') }}\n    AND {{ filter('LISTENING_CONTEXT') }}\n    AND {{ filter('COUNTRY') }}\nGROUP BY\n    AGE_BAND\nORDER BY\n    AGE_BAND",
