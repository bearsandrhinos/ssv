      ],
      "sql": "WITH base AS (\n    SELECT\n        s.STREAM_ID,\n        s.USER_ID,\n        s.STARTED_AT::DATE AS STREAM_DATE,\n        s.LISTENED_MIN,\n        s.COMPLETION_PCT,\n        s.DOWNLOADED,\n        s.LISTENING_CONTEXT,\n        p.TITLE,\n        p.GENRE,\n        p.RATING,\n        p.SUBSCRIBER_COUNT,\n        u.AGE,\n        u.GENDER,\n        u.COUNTRY,\n        u.STATE,\n        u.TRAFFIC_SOURCE\n    FROM ANALYTICS_PROD.COCO_DEMO.STREAMS s\n    LEFT JOIN ANALYTICS_PROD.COCO_DEMO.PODCASTS p\n        ON s.PODCAST_ID = p.PODCAST_ID\n    LEFT JOIN ANALYTICS_PROD.COCO_DEMO.USERS u\n        ON s.USER_ID = u.ID\n)\nSELECT\n    LEAST(FLOOR(COMPLETION_PCT / 10) * 10, 90) AS COMPLETION_BUCKET,\n    COUNT(STREAM_ID) AS STREAMS\nFROM base\nWHERE\n    {{ filter('STREAM_DATE') }}\n    AND {{ filter('GENRE') }}\n    AND {{ filter('LISTENING_CONTEXT') }}\n    AND {{ filter('COUNTRY') }}\nGROUP BY\n    COMPLETION_BUCKET\nORDER BY\n    COMPLETION_BUCKET",
